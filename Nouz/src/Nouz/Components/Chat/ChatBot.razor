@inherits SharedComponentBase
@namespace Nouz.Components.Chat
@using Nouz.Application.Chat

<div class="chat-container">
    <div class="chat-messages" @ref="_messagesContainer">
        @if (_messages.Count == 0)
        {
            <div class="chat-empty">
                <RadzenIcon Icon="chat_bubble_outline" Style="font-size: 32px;" />
                <p>Start a conversation with the AI assistant</p>
            </div>
        }
        else
        {
            @foreach (var message in _messages)
            {
                <div class="chat-message @(message.Role == ChatMessageRole.User ? "user" : "assistant")">
                    <div class="message-avatar">
                        @if (message.Role == ChatMessageRole.User)
                        {
                            <RadzenIcon Icon="person" />
                        }
                        else
                        {
                            <RadzenIcon Icon="smart_toy" />
                        }
                    </div>
                    <div class="message-content">
                        <div class="message-header">
                            <span class="message-role">@(message.Role == ChatMessageRole.User ? "You" : "Assistant")</span>
                            <span class="message-time">@message.Timestamp.ToString("HH:mm")</span>
                        </div>
                        @if (message.Role == ChatMessageRole.User)
                        {
                            <div class="message-text">@message.Content</div>
                        }
                        else
                        {
                            @if (message.Id == _streamingMessageId && string.IsNullOrEmpty(message.Content) && (message.ToolCalls is null || message.ToolCalls.Count == 0))
                            {
                                <div class="typing-indicator">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </div>
                            }
                            @if (message.ToolCalls is { Count: > 0 })
                            {
                                var hasRunning = message.ToolCalls.Any(t => !t.IsCompleted);
                                var hasText = !string.IsNullOrEmpty(message.Content);

                                @if (hasRunning)
                                {
                                    <div class="tool-calls-expanded">
                                        @foreach (var activity in message.ToolCalls)
                                        {
                                            <div class="tool-call-item @(activity.IsCompleted ? "completed" : "running")">
                                                @if (activity.IsCompleted)
                                                {
                                                    <RadzenIcon Icon="check_circle" Style="font-size: 12px;" />
                                                }
                                                else
                                                {
                                                    <span class="tool-call-spinner"></span>
                                                }
                                                <span>@activity.Label</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (hasText)
                                {
                                    <div class="tool-calls-chip" @onclick="() => ToggleToolCalls(message.Id)">
                                        <RadzenIcon Icon="build" Style="font-size: 13px;" />
                                        <span>@message.ToolCalls.Count action@(message.ToolCalls.Count != 1 ? "s" : "")</span>
                                        <RadzenIcon Icon="@(_expandedToolCallIds.Contains(message.Id) ? "expand_less" : "expand_more")" Style="font-size: 14px;" />
                                    </div>
                                    @if (_expandedToolCallIds.Contains(message.Id))
                                    {
                                        <div class="tool-calls-list">
                                            @foreach (var activity in message.ToolCalls)
                                            {
                                                <div class="tool-call-item completed">
                                                    <RadzenIcon Icon="check_circle" Style="font-size: 12px;" />
                                                    <span>@activity.Label</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="tool-calls-expanded">
                                        @foreach (var activity in message.ToolCalls)
                                        {
                                            <div class="tool-call-item completed">
                                                <RadzenIcon Icon="check_circle" Style="font-size: 12px;" />
                                                <span>@activity.Label</span>
                                            </div>
                                        }
                                        @if (message.Id == _streamingMessageId)
                                        {
                                            <div class="tool-call-pending">
                                                <span></span>
                                                <span></span>
                                                <span></span>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            @if (!string.IsNullOrEmpty(message.Content))
                            {
                                <div class="message-text assistant-message">
                                    <MarkdownRenderer Content="@message.Content" />
                                </div>
                            }
                            @if (message.ContextNoteTitles is { Count: > 0 })
                            {
                                <div class="note-context-chip" @onclick="() => ToggleNoteContext(message.Id)">
                                    <RadzenIcon Icon="description" Style="font-size: 13px;" />
                                    <span>@message.ContextNoteTitles.Count note@(message.ContextNoteTitles.Count != 1 ? "s" : "") referenced</span>
                                    <RadzenIcon Icon="@(_expandedNoteContextIds.Contains(message.Id) ? "expand_less" : "expand_more")" Style="font-size: 14px;" />
                                </div>
                                @if (_expandedNoteContextIds.Contains(message.Id))
                                {
                                    <div class="note-context-expanded">
                                        @foreach (var title in message.ContextNoteTitles)
                                        {
                                            <div class="note-context-item">
                                                <RadzenIcon Icon="article" Style="font-size: 12px;" />
                                                <span>@title</span>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            }

            @if (_isTyping && _streamingMessageId == null)
            {
                <div class="chat-message assistant">
                    <div class="message-avatar">
                        <RadzenIcon Icon="smart_toy" />
                    </div>
                    <div class="message-content">
                        <div class="typing-indicator">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="chat-input-area">
        <textarea class="chat-input"
                  placeholder="Type a message..."
                  @bind="_inputText"
                  @bind:event="oninput"
                  @onkeydown="HandleKeyDown"
                  rows="1"
                  disabled="@(_isTyping || _isStreaming)"></textarea>
        <button class="send-button"
                @onclick="SendMessage"
                disabled="@(string.IsNullOrWhiteSpace(_inputText) || _isTyping || _isStreaming)">
            <RadzenIcon Icon="send" />
        </button>
        @if (_messages.Count > 0)
        {
            <button class="clear-button"
                    @onclick="ClearChat"
                    disabled="@(_isTyping || _isStreaming)"
                    title="Clear chat history">
                <RadzenIcon Icon="delete_outline" />
            </button>
        }
    </div>
</div>
