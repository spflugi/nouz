<div class="image-preview-backdrop"
     @onclick="Close"
     style="@(_isVisible ? "display:flex" : "display:none")">
    <div class="image-preview-container"
         @onclick:stopPropagation="true">
        <button class="close-button" @onclick="Close" title="Close">
            <RadzenIcon Icon="close" />
        </button>
        @if (!string.IsNullOrEmpty(_imageDataUrl))
        {
            <img src="@_imageDataUrl" alt="@_caption" class="preview-image" />
            @if (!string.IsNullOrEmpty(_caption))
            {
                <div class="preview-caption">@_caption</div>
            }
        }
    </div>
</div>
