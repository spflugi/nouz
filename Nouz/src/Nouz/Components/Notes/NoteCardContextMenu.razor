@using Nouz.Domain.Entities

<div class="note-context-menu" @onclick:stopPropagation="true">
    <div class="menu-section">
        <button class="menu-item" @onclick="HandleAddAttachment">
            <RadzenIcon Icon="attach_file" />
            <span>Add attachment</span>
        </button>
        <div class="menu-item-with-submenu">
            <button class="menu-item" @onclick="ToggleMoveSubmenu">
                <RadzenIcon Icon="drive_file_move" />
                <span>Move to notebook</span>
                <RadzenIcon Icon="@(_showMoveSubmenu ? "expand_less" : "expand_more")" class="submenu-arrow" />
            </button>
            @if (_showMoveSubmenu)
            {
                <div class="submenu">
                    @foreach (var notebook in Notebooks)
                    {
                        <button class="menu-item @(notebook.Id == CurrentNotebookId ? "disabled" : "")"
                                @onclick="@(() => SelectNotebook(notebook))"
                                disabled="@(notebook.Id == CurrentNotebookId)">
                            <RadzenIcon Icon="book" />
                            <span>@notebook.Name</span>
                            @if (notebook.Id == CurrentNotebookId)
                            {
                                <span class="current-badge">Current</span>
                            }
                        </button>
                    }
                </div>
            }
        </div>
        <div class="menu-item-with-submenu">
            <button class="menu-item" @onclick="ToggleExportSubmenu">
                <RadzenIcon Icon="download" />
                <span>Export</span>
                <RadzenIcon Icon="@(_showExportSubmenu ? "expand_less" : "expand_more")" class="submenu-arrow" />
            </button>
            @if (_showExportSubmenu)
            {
                <div class="submenu">
                    <button class="menu-item" @onclick="HandleExportHtml">
                        <RadzenIcon Icon="code" />
                        <span>As HTML</span>
                    </button>
                    <button class="menu-item" @onclick="HandleExportPdf">
                        <RadzenIcon Icon="picture_as_pdf" />
                        <span>As PDF</span>
                    </button>
                </div>
            }
        </div>
    </div>
    <div class="menu-divider"></div>
    <div class="menu-section">
        <button class="menu-item menu-item-danger" @onclick="@(() => OnDeleteSelected.InvokeAsync())">
            <RadzenIcon Icon="delete" />
            <span>Delete</span>
        </button>
    </div>
</div>

<div class="menu-backdrop" @onclick="@(() => OnClose.InvokeAsync())"></div>
