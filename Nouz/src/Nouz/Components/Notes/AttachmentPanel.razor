@using System.Collections.Immutable
@using Nouz.Domain.Entities

<div class="attachment-panel">
    <button class="attachment-button @(_showDropdown ? "active" : "")"
            title="@(_attachments.Count > 0 ? $"{_attachments.Count} attachment(s)" : "No attachments")"
            @onclick="ToggleDropdown"
            @onclick:stopPropagation="true">
        <RadzenIcon Icon="attach_file" Style="font-size: 18px;" />
        @if (_attachments.Count > 0)
        {
            <span class="attachment-count">@_attachments.Count</span>
        }
    </button>

    @if (_showDropdown)
    {
        <div class="attachment-dropdown" @onclick:stopPropagation="true">
            <div class="attachment-list">
                @if (_attachments.Count == 0)
                {
                    <div class="attachment-empty">
                        <span>No attachments</span>
                    </div>
                }
                else
                {
                    @foreach (var attachment in _attachments)
                    {
                        <div class="attachment-item" @onclick="() => HandleOpenAttachment(attachment.Id)">
                            <div class="attachment-icon">
                                <RadzenIcon Icon="@GetFileIcon(attachment.Extension)" Style="font-size: 16px;" />
                            </div>
                            <div class="attachment-info">
                                <span class="attachment-name" title="@attachment.FileName">@TruncateFileName(attachment.FileName)</span>
                                <span class="attachment-meta">@FormatFileSize(attachment.FileSizeBytes) · @attachment.AddedAt.LocalDateTime.ToString("dd. MMM yyyy")</span>
                            </div>
                            <button class="attachment-delete"
                                    title="Remove attachment"
                                    @onclick="() => HandleDeleteAttachment(attachment.Id)"
                                    @onclick:stopPropagation="true">
                                <RadzenIcon Icon="close" Style="font-size: 14px;" />
                            </button>
                        </div>
                    }
                }
            </div>
            <div class="attachment-actions">
                <label class="attachment-add-button">
                    <RadzenIcon Icon="add" Style="font-size: 16px;" />
                    <span>Add attachment</span>
                    <InputFile OnChange="HandleFileSelected" style="display: none;" />
                </label>
            </div>
        </div>
    }
</div>

@if (_showDropdown)
{
    <div class="attachment-overlay" @onclick="CloseDropdown"></div>
}
