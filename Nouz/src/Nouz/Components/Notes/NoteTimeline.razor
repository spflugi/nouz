@inherits SharedComponentBase
@using Nouz.Components.Modals

<TextInputModal @ref="TextModal" />
<ConfirmationModal @ref="ConfirmationModal" />
<ImagePreviewModal @ref="_imagePreviewModal" />

<div class="note-timeline">
    @if (_selectedNotebookId is not null)
    {
        <div class="timeline-content">
            @if (_notes.Count == 0)
            {
                <div class="empty-state">
                    <p>No notes yet</p>
                    <p class="hint">Click the + button in the top bar to create your first note</p>
                </div>
            }
            else
            {
                @foreach (var note in _notes)
                {
                    <NoteCard @key="note.Id"
                              Note="@note"
                              Notebooks="@_notebooks"
                              Attachments="@GetAttachmentsForNote(note.Id)"
                              IsEditing="@(_editingNoteId == note.Id)"
                              EditingBlockId="@(_editingNoteId == note.Id ? _editingBlockId : null)"
                              OnDelete="@(noteId => DeleteNote(noteId))"
                              OnMoveToNotebook="@(args => MoveNote(args.NoteId, args.NewNotebookId))"
                              OnSave="@(updatedNote => HandleSaveNote(updatedNote))"
                              OnBlockClick="@(args => HandleBlockClick(args.NoteId, args.BlockId))"
                              OnBlockContentChanged="@(args => HandleBlockContentChanged(args.NoteId, args.Block))"
                              OnBlockAdd="@(args => HandleBlockAdd(args.NoteId, args.AfterBlockId, args.BlockType, args.Metadata))"
                              OnBlockTypeChange="@(args => HandleBlockTypeChange(args.NoteId, args.BlockId, args.NewType))"
                              OnBlockDelete="@(args => HandleBlockDelete(args.NoteId, args.BlockId))"
                              OnBlockReorder="@(args => HandleBlockReorder(args.NoteId, args.BlockId, args.NewIndex))"
                              OnImagePasted="@(args => HandleImagePasted(args.NoteId, args.AfterBlockId, args.ImageData, args.FileName, args.MimeType))"
                              OnImageCaptionChanged="@(args => HandleImageCaptionChanged(args.NoteId, args.BlockId, args.Caption))"
                              OnImageWidthChanged="@(args => HandleImageWidthChanged(args.NoteId, args.BlockId, args.WidthPercent))"
                              OnImagePreviewRequested="@(args => ShowImagePreview(args.ImageDataUrl, args.Caption))"
                              OnAddAttachment="@(args => HandleAddAttachment(args.NoteId, args.FileStream, args.FileName))"
                              OnDeleteAttachment="@(args => HandleDeleteAttachment(args.NoteId, args.AttachmentId))"
                              OnOpenAttachment="@(attachmentId => HandleOpenAttachment(attachmentId))"
                              OnMermaidToggleEditMode="@(args => HandleMermaidToggleEditMode(args.NoteId, args.BlockId))"
                              OnTableAddRow="@(args => HandleTableAddRow(args.NoteId, args.BlockId, args.AfterRowIndex))"
                              OnTableRemoveRow="@(args => HandleTableRemoveRow(args.NoteId, args.BlockId, args.RowIndex))"
                              OnTableAddColumn="@(args => HandleTableAddColumn(args.NoteId, args.BlockId, args.AfterColumnIndex))"
                              OnTableRemoveColumn="@(args => HandleTableRemoveColumn(args.NoteId, args.BlockId, args.ColumnIndex))"
                              OnTableCellChanged="@(args => HandleTableCellChanged(args.NoteId, args.BlockId, args.RowIndex, args.ColIndex, args.Content))" />
                }
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>Select a notebook</p>
            <p class="hint">Choose a notebook from the sidebar to view its notes</p>
        </div>
    }
</div>
