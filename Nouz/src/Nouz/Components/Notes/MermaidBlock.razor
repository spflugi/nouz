@using Nouz.Domain.Entities
@inject IJSRuntime JsRuntime

<div class="block block-mermaid @(IsEditMode ? "edit-mode" : "preview-mode")">
    @if (IsEditMode)
    {
        <pre class="mermaid-code">
            <code contenteditable="true"
                  spellcheck="false"
                  @ref="_codeRef"
                  @oninput="HandleInput"
                  data-placeholder="Enter Mermaid diagram code..."></code>
        </pre>
        <button class="mermaid-toggle" @onclick="HandleToggleMode" title="Preview diagram">
            <RadzenIcon Icon="visibility" />
        </button>
    }
    else
    {
        <div class="mermaid-preview @(_hasError ? "has-error" : "")" @ref="_previewRef">
            @if (_hasError)
            {
                <div class="mermaid-error">
                    <RadzenIcon Icon="error_outline" />
                    <span>@_errorMessage</span>
                </div>
            }
        </div>
        <button class="mermaid-toggle" @onclick="HandleToggleMode" title="Edit code">
            <RadzenIcon Icon="edit" />
        </button>
    }
</div>
