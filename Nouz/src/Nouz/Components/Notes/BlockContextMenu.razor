@using Nouz.Domain.Entities

<div class="block-context-menu" @onclick:stopPropagation="true">
    <div class="menu-section">
        <span class="menu-section-title">Turn into</span>
        <button class="menu-item @(CurrentType == BlockType.Paragraph ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.Paragraph))">
            <RadzenIcon Icon="notes" />
            <span>Paragraph</span>
        </button>
        <button class="menu-item @(CurrentType == BlockType.H1 ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.H1))">
            <span class="heading-icon">H1</span>
            <span>Heading 1</span>
        </button>
        <button class="menu-item @(CurrentType == BlockType.H2 ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.H2))">
            <span class="heading-icon">H2</span>
            <span>Heading 2</span>
        </button>
        <button class="menu-item @(CurrentType == BlockType.H3 ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.H3))">
            <span class="heading-icon">H3</span>
            <span>Heading 3</span>
        </button>
        <button class="menu-item @(CurrentType == BlockType.H4 ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.H4))">
            <span class="heading-icon">H4</span>
            <span>Heading 4</span>
        </button>
        <button class="menu-item @(CurrentType == BlockType.ListItem ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.ListItem))">
            <RadzenIcon Icon="format_list_bulleted" />
            <span>List item</span>
        </button>
        <button class="menu-item @(CurrentType == BlockType.TodoItem ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.TodoItem))">
            <RadzenIcon Icon="check_box" />
            <span>To-do</span>
        </button>
        <button class="menu-item @(CurrentType == BlockType.AgendaItem ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.AgendaItem))">
            <RadzenIcon Icon="chevron_right" />
            <span>Agenda item</span>
        </button>
        <button class="menu-item @(CurrentType == BlockType.Code ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.Code))">
            <RadzenIcon Icon="code" />
            <span>Code</span>
        </button>
        <button class="menu-item @(CurrentType == BlockType.Quote ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.Quote))">
            <RadzenIcon Icon="format_quote" />
            <span>Quote</span>
        </button>
        <button class="menu-item @(CurrentType == BlockType.Decision ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.Decision))">
            <RadzenIcon Icon="gavel" />
            <span>Decision</span>
        </button>
        <button class="menu-item @(CurrentType == BlockType.Warning ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.Warning))">
            <RadzenIcon Icon="warning" />
            <span>Warning</span>
        </button>
        <button class="menu-item @(CurrentType == BlockType.Divider ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.Divider))">
            <RadzenIcon Icon="horizontal_rule" />
            <span>Divider</span>
        </button>
        <button class="menu-item @(CurrentType == BlockType.Mermaid ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.Mermaid))">
            <RadzenIcon Icon="account_tree" />
            <span>Diagram</span>
        </button>
        <button class="menu-item @(CurrentType == BlockType.Table ? "active" : "")"
                @onclick="@(() => OnTypeSelected.InvokeAsync(BlockType.Table))">
            <RadzenIcon Icon="table_chart" />
            <span>Table</span>
        </button>
    </div>
    <div class="menu-divider"></div>
    <div class="menu-section">
        <span class="menu-section-title">Insert</span>
        <button class="menu-item"
                @onclick="@(() => OnInsertImageRequested.InvokeAsync())">
            <RadzenIcon Icon="image" />
            <span>Image</span>
        </button>
    </div>
    <div class="menu-divider"></div>
    <div class="menu-section">
        <button class="menu-item menu-item-danger" @onclick="@(() => OnDeleteSelected.InvokeAsync())">
            <RadzenIcon Icon="delete" />
            <span>Delete</span>
        </button>
    </div>
</div>

<div class="menu-backdrop" @onclick="@(() => OnClose.InvokeAsync())"></div>
