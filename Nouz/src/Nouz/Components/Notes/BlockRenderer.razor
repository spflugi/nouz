@using Nouz.Domain.Entities
@inject IJSRuntime JsRuntime

<div class="block-wrapper @(IsEditing ? "editing" : "") @(_isDragOver ? "drag-over" : "") @(_isDragging ? "dragging" : "")"
     @onmouseenter="ShowMenu"
     @onmouseleave="HideMenu"
     @ondragover="@HandleDragOver"
     @ondragover:preventDefault="true"
     @ondragleave="@HandleDragLeave"
     @ondrop="@HandleDrop"
     @ondrop:preventDefault="true">

    <div class="block-menu-trigger @(_showMenu || IsEditing ? "visible" : "")"
         draggable="true"
         @ondragstart="@HandleDragStart"
         @ondragstart:stopPropagation="true"
         @ondragend="@HandleDragEnd"
         @onclick="ToggleContextMenu"
         @onclick:stopPropagation="true">
        <RadzenIcon Icon="drag_indicator" Style="font-size: 16px; color: var(--text-muted); cursor: grab;" />
    </div>

    @if (_showContextMenu)
    {
        <BlockContextMenu OnTypeSelected="HandleTypeSelected"
                          OnInsertImageRequested="HandleInsertImageRequested"
                          OnDeleteSelected="HandleDeleteSelected"
                          OnClose="CloseContextMenu"
                          CurrentType="Block.Type" />
    }

    <input type="file"
           @ref="_imageFileInputRef"
           accept="image/*"
           style="display: none;"
           @onchange="HandleImageFileSelected" />

    <FormattingToolbar IsVisible="_showFormattingToolbar"
                       SelectionRect="_selectionRect"
                       IsBold="_selectionIsBold"
                       IsItalic="_selectionIsItalic"
                       CurrentColor="_selectionColor"
                       OnFormat="HandleFormat"
                       OnColorSelected="HandleColorSelected" />

    <div class="block-content" @onclick="HandleClick">
        @switch (Block.Type)
        {
            case BlockType.Paragraph:
                <p class="block block-paragraph formattable"
                   contenteditable="true"
                   @ref="_contentRef"
                   data-placeholder="Type something..."></p>
                break;

            case BlockType.H1:
                <h1 class="block block-h1"
                    contenteditable="true"
                    @ref="_contentRef"
                    data-placeholder="Heading 1"></h1>
                break;

            case BlockType.H2:
                <h2 class="block block-h2"
                    contenteditable="true"
                    @ref="_contentRef"
                    data-placeholder="Heading 2"></h2>
                break;

            case BlockType.H3:
                <h3 class="block block-h3"
                    contenteditable="true"
                    @ref="_contentRef"
                    data-placeholder="Heading 3"></h3>
                break;

            case BlockType.H4:
                <h4 class="block block-h4"
                    contenteditable="true"
                    @ref="_contentRef"
                    data-placeholder="Heading 4"></h4>
                break;

            case BlockType.ListItem:
                <div class="block block-list-item" style="padding-left: @(GetIndentLevel() * 20)px">
                    <span class="list-bullet"></span>
                    <span class="list-content"
                          contenteditable="true"
                          @ref="_contentRef"
                          data-placeholder="List item"></span>
                </div>
                break;

            case BlockType.TodoItem:
                <div class="block block-todo-item @(GetCheckedState() ? "checked" : "")">
                    <input type="checkbox"
                           checked="@GetCheckedState()"
                           @onchange="HandleTodoCheckedChange" />
                    <span class="todo-content"
                          contenteditable="true"
                          @ref="_contentRef"
                          data-placeholder="To-do"></span>
                </div>
                break;

            case BlockType.Code:
                <pre class="block block-code"><code contenteditable="true"
                       @ref="_contentRef"
                       data-placeholder="Code"
                       spellcheck="false"></code></pre>
                break;

            case BlockType.Quote:
                <blockquote class="block block-quote">
                    <span class="quote-content"
                          contenteditable="true"
                          @ref="_contentRef"
                          data-placeholder="Quote"></span>
                </blockquote>
                break;

            case BlockType.AgendaItem:
                <div class="block block-agenda-item" style="padding-left: @(GetIndentLevel() * 20)px">
                    <RadzenIcon Icon="chevron_right" class="agenda-chevron" />
                    <span class="agenda-content"
                          contenteditable="true"
                          @ref="_contentRef"
                          data-placeholder="Agenda item"></span>
                </div>
                break;

            case BlockType.Decision:
                <div class="block block-decision">
                    <span class="decision-content"
                          contenteditable="true"
                          @ref="_contentRef"
                          data-placeholder="Decision"></span>
                </div>
                break;

            case BlockType.Warning:
                <div class="block block-warning">
                    <span class="warning-content"
                          contenteditable="true"
                          @ref="_contentRef"
                          data-placeholder="Warning"></span>
                </div>
                break;

            case BlockType.Divider:
                <div class="block block-divider" @ref="_contentRef">
                    <hr />
                </div>
                break;

            case BlockType.Image:
                <div class="block block-image" @ref="_contentRef"
                     @ondragover="@HandleImageDragOver"
                     @ondragover:preventDefault="true"
                     @ondrop="@HandleImageDrop"
                     @ondrop:preventDefault="true">
                    @if (!string.IsNullOrEmpty(_imageDataUrl))
                    {
                        <div class="image-resizable-container" style="width: @(GetImageWidthPercent())%;">
                            <img src="@_imageDataUrl"
                                 alt="@GetImageCaption()"
                                 @onclick="HandleImageClick"
                                 @onclick:stopPropagation="true"
                                 title="Click to view full size" />
                            <div class="resize-handle resize-handle-right"
                                 @ref="_resizeHandleRef"
                                 title="Drag to resize"></div>
                        </div>
                        <input type="text"
                               class="image-caption"
                               placeholder="Add a caption..."
                               value="@GetImageCaption()"
                               @onchange="HandleCaptionChange"
                               style="width: @(GetImageWidthPercent())%;" />
                    }
                    else
                    {
                        <div class="image-placeholder">
                            <RadzenIcon Icon="image" />
                            <span>Loading image...</span>
                        </div>
                    }
                </div>
                break;

            case BlockType.Mermaid:
                <MermaidBlock @ref="_mermaidBlockRef"
                              Block="Block"
                              NoteId="NoteId"
                              OnContentChanged="HandleMermaidContentChanged"
                              OnToggleEditMode="HandleMermaidToggleEditMode"
                              OnSaveRequested="OnSaveRequested"
                              OnInsertBlockAfter="HandleMermaidInsertBlockAfter" />
                break;

            case BlockType.Table:
                <TableBlock Block="Block"
                            NoteId="NoteId"
                            OnAddRow="HandleTableAddRow"
                            OnRemoveRow="HandleTableRemoveRow"
                            OnAddColumn="HandleTableAddColumn"
                            OnRemoveColumn="HandleTableRemoveColumn"
                            OnCellChanged="HandleTableCellChanged"
                            OnInsertBlockAfter="HandleTableInsertBlockAfter" />
                break;

            default:
                <p class="block block-paragraph"
                   contenteditable="true"
                   @ref="_contentRef"
                   data-placeholder="Type something..."></p>
                break;
        }
    </div>
</div>
