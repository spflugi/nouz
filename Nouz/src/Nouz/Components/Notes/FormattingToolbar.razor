@using Nouz.Domain.Entities

@if (IsVisible && SelectionRect is not null)
{
    <div class="formatting-toolbar"
         style="top: @(SelectionRect.Top - 40)px; left: @(SelectionRect.Left + SelectionRect.Width / 2)px;"
         @onclick:stopPropagation="true"
         @onmousedown:preventDefault="true"
         @onmousedown:stopPropagation="true">

        <button class="toolbar-btn @(IsBold ? "active" : "")"
                title="Bold"
                @onmousedown="@(() => OnFormatClick(TextFormatType.Bold))"
                @onmousedown:preventDefault="true">
            <strong>B</strong>
        </button>

        <button class="toolbar-btn @(IsItalic ? "active" : "")"
                title="Italic"
                @onmousedown="@(() => OnFormatClick(TextFormatType.Italic))"
                @onmousedown:preventDefault="true">
            <em>I</em>
        </button>

        <div class="toolbar-divider"></div>

        <div class="color-picker-wrapper">
            <button class="toolbar-btn color-btn"
                    title="Text color"
                    @onmousedown="ToggleColorPicker"
                    @onmousedown:preventDefault="true">
                <span class="color-indicator" style="background-color: @(CurrentColor ?? "var(--text-primary)")"></span>
                <span class="color-icon">A</span>
            </button>

            @if (_showColorPicker)
            {
                <div class="color-picker-dropdown">
                    <button class="color-option default-color"
                            title="Default"
                            @onmousedown="@(() => OnColorClick(null))"
                            @onmousedown:preventDefault="true">
                        <RadzenIcon Icon="format_color_reset" Style="font-size: 14px;" />
                    </button>
                    @foreach (var color in _colors)
                    {
                        <button class="color-option"
                                style="background-color: @color"
                                title="@color"
                                @onmousedown="@(() => OnColorClick(color))"
                                @onmousedown:preventDefault="true">
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private bool _showColorPicker;

    private readonly string[] _colors =
    [
        "#ef4444", // Red
        "#f97316", // Orange
        "#eab308", // Yellow
        "#22c55e", // Green
        "#3b82f6", // Blue
        "#a855f7", // Purple
        "#ec4899", // Pink
        "#6b7280"  // Gray
    ];

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public SelectionRectData? SelectionRect { get; set; }

    [Parameter]
    public bool IsBold { get; set; }

    [Parameter]
    public bool IsItalic { get; set; }

    [Parameter]
    public string? CurrentColor { get; set; }

    [Parameter]
    public EventCallback<TextFormatType> OnFormat { get; set; }

    [Parameter]
    public EventCallback<string?> OnColorSelected { get; set; }

    private async Task OnFormatClick(TextFormatType formatType)
    {
        _showColorPicker = false;
        await OnFormat.InvokeAsync(formatType);
    }

    private void ToggleColorPicker()
    {
        _showColorPicker = !_showColorPicker;
    }

    private async Task OnColorClick(string? color)
    {
        _showColorPicker = false;
        await OnColorSelected.InvokeAsync(color);
    }

    public class SelectionRectData
    {
        public double Top { get; set; }
        public double Left { get; set; }
        public double Bottom { get; set; }
        public double Right { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }
}
