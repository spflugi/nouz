@using Nouz.Components.Chat
@inherits SharedComponentBase
@implements IAsyncDisposable

@if (!_isCollapsed)
{
    <div class="right-sidebar"
         @ref="_sidebarRef"
         style="width: @(_sidebarWidth)px">

        <div class="sidebar-resize-handle" @ref="_resizeHandleRef"></div>

        <div class="sidebar-header">
            <div class="sidebar-header-actions">
                <RadzenButton Icon="chevron_right"
                              Variant="Variant.Text"
                              Style="color: var(--text-muted);"
                              Click="@ToggleCollapse"
                              title="Collapse sidebar" />
            </div>
            <h2>Assistant</h2>
        </div>

        <div class="sidebar-content">
            <ChatBot />
        </div>
    </div>
}
else
{
    <div class="right-sidebar-toggle">
        <RadzenButton Icon="smart_toy"
                      Variant="Variant.Text"
                      Style="color: var(--text-muted);"
                      Click="@ToggleCollapse"
                      title="Open Assistant" />
    </div>
}
