@inherits SharedComponentBase
@implements IAsyncDisposable
@using Nouz.Components.Modals

<TextInputModal @ref="TextModal" />
<ConfirmationModal @ref="ConfirmationModal" />

@if (!_isCollapsed)
{
    <div class="sidebar"
         @ref="_sidebarRef"
         style="width: @(_sidebarWidth)px">

        <div class="sidebar-header">
            <h2>Notebooks</h2>
            <div class="sidebar-header-actions">
                <RadzenButton Icon="add"
                              Variant="Variant.Text"
                              Style="color: var(--text-muted);"
                              Click="@CreateNotebook"
                              title="New notebook" />
                <RadzenButton Icon="chevron_left"
                              Variant="Variant.Text"
                              Style="color: var(--text-muted);"
                              Click="@ToggleCollapse"
                              title="Collapse sidebar" />
            </div>
        </div>

        <div class="notebook-list">
            @foreach (var notebook in _notebooks)
            {
                <NotebookItem Notebook="@notebook"
                              IsSelected="@(notebook.Id == _selectedNotebookId)"
                              OnSelect="@SelectNotebook"
                              OnRename="@RenameNotebook"
                              OnDelete="@DeleteNotebook" />
            }
        </div>

        <div class="sidebar-resize-handle" @ref="_resizeHandleRef"></div>
    </div>
}
else
{
    <div class="sidebar-toggle">
        <RadzenButton Icon="menu"
                      Variant="Variant.Text"
                      Style="color: var(--text-muted);"
                      Click="@ToggleCollapse"
                      title="Open sidebar" />
    </div>
}