@inherits SharedComponentBase

<div class="searchbar">
    
    @if (_selectedNotebookId is not null)
    {
        <RadzenIcon Icon="search"
                    Style="color: var(--text-muted);" />
        <input type="text"
               placeholder="Search notes..."
               value="@_query"
               @oninput="HandleSearchInput" />
        <RadzenButton Icon="close"
                      Variant="Variant.Text"
                      Style="@($"color: var(--text-muted); visibility: {(string.IsNullOrEmpty(_query) ? "hidden" : "visible")}")"
                      Click="@(() => ClearSearchInput())"
                      title="Clear search" />

        <div class="searchbar-divider"></div>
        <RadzenButton Icon="add"
                      Variant="Variant.Text"
                      Style="color: var(--text-muted);"
                      Click="@CreateNote"
                      title="New note" />
        <RadzenButton Icon="settings"
                      Variant="Variant.Text"
                      Style="color: var(--text-muted);"
                      Click="@OpenSettings"
                      title="Open settings" />
    }
</div>